# Leave DATABASE_URL unset for process-local in-memory interaction storage.
# PostgreSQL example:
DATABASE_URL=postgresql+psycopg://recommendation:recommendation@localhost:5432/recommendation

# Leave REDIS_URL unset to use process-local in-memory recommendation caching.
# Redis example:
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
# Bump the namespace when the ranking model or cache payload schema changes.
CACHE_NAMESPACE=recommendations:v1
